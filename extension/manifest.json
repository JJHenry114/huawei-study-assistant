{
  "manifest_version": 3,
  "name": "学堂随课助手",
  "version": "1.5.0",
  "description": "在华为开发者学堂按节学习，用自选 AI 接口完成文字与配图选择题，考试由你复查并手动交卷。",
  "minimum_chrome_version": "106",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://developer.huawei.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "学堂随课助手", "default_popup": "popup.html"},
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://developer.huawei.com/consumer/cn/training/*"],
    "js": ["shared.js", "question-images.js", "adapter.js", "playback.js", "runner.js", "exam.js"],
    "run_at": "document_idle"
  }]
}
